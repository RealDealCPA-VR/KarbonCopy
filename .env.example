# --- KarbonCopy environment ---

# SQLite database file (local-first)
DATABASE_URL=file:./data/karboncopy.db

# Server
# Environment mode. `pnpm start` sets this to "production" automatically (via
# cross-env). Set it yourself only if you launch the server some other way —
# leaving it unset runs in dev mode and weakens the portal cookie's secure flag.
NODE_ENV=production
PORT=3000
# Bind to 0.0.0.0 so every device on the LAN can reach the app.
# (Use HOST, not HOSTNAME — shells export HOSTNAME and it would shadow this.)
HOST=0.0.0.0

# Fallback for APP_ENCRYPTION_KEY (below): encrypts EIN/SSN + integration/email
# secrets at rest (AES-256-GCM). Not used for sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Encrypts EIN/SSN at rest (AES-256-GCM). MUST be set + stable in production.
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Set to "true" ONLY if you front the staff app with HTTPS. Leave unset for the
# default plain-HTTP LAN deployment (a secure cookie would never be sent over HTTP).
COOKIE_SECURE=false
# Max client/staff upload size in MB
MAX_UPLOAD_MB=50

# Public URL clients hit (used for client-portal magic links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File-server watch roots (comma-separated UNC or local paths)
# Example: \\FILESERVER\Clients,\\FILESERVER\TaxReturns
WATCH_ROOTS=

# Claude AI (optional — enables AI drafting/summaries)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Stripe (optional — enables hosted-checkout card payments + webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# MCP server (optional — enables the Claude Desktop / Claude Code integration via
# `pnpm mcp`). Create a key via the ⌘K command palette → "API Keys" (or visit
# /settings/api-keys), then paste it here.
KARBONCOPY_API_KEY=
